+  <string name="ChatsSettingsFragment__ignore_remote_delete_summary">Keep messages when their author requests deletion; group admin and linked-device deletions still apply. Kept messages may appear in backups and exports, including on another device after restore. Turning this off does not delete messages or media already kept.</string>
   <string name="ChatsSettingsFragment__delete_media_only">Delete media only</string>
