-              audioBitrate = audioKiloBitrate * KILOBIT,
-              enableFastStart = enableFastStart,
-              enableAudioRemux = enableAudioRemux
-            ),
-            onProgress = { percent -> _transcodingState.value = TranscodingState.InProgress(percent) }
-          )
-        }
