Date: Sun, 1 Nov 2026 11:08:41 +0100
Subject: [PATCH] Restore linked-device reminder after re-registration

Mark existing-account registration explicitly and restore the Molly reminder after successful primary-device multi-device re-registration. Add focused coverage for the entry-point marker and reminder policy.

AI-assisted compatibility changes: restore imports across source checkpoints.

AI-assisted compatibility changes: use a seven-day duration in the existing backup exporter test.

AI-assisted compatibility changes: restore Molly logger collection.
Based-On-Source-Commit: 728093b889239fe6313ffa39244d8b4d7e784214
Source-Commit: 7cb1696b6dcf788497325176514f5f2a1cff9f12
---
 .../registration/ui/RegistrationActivity.kt   | 15 ++++++++-
 .../registration/ui/RegistrationIntents.kt    |  7 +++-
 .../ui/RegistrationIntentsTest.kt             | 32 +++++++++++++++++++
 3 files changed, 52 insertions(+), 2 deletions(-)
 create mode 100644 app/src/test/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntentsTest.kt

diff --git a/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationActivity.kt b/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationActivity.kt
index 84bf943f..99672a78 100644
--- a/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationActivity.kt
+++ b/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationActivity.kt
@@ -50,6 +50,7 @@ class RegistrationActivity : PassphraseRequiredActivity() {
     private const val REGISTRATION_NEXT_INTENT_EXTRA = "next_intent"
     private const val START_DESTINATION_EXTRA = "start_destination"
     private const val START_FRESH_EXTRA = "start_fresh"
+    internal const val IS_REREGISTRATION_EXTRA = "is_reregistration"
 
     /**
      * @param nextIntent An optional intent to launch once registration completes successfully. This is how the caller
@@ -59,10 +60,17 @@ class RegistrationActivity : PassphraseRequiredActivity() {
      *   to send a deregistered linked device straight to the link-device screen.
      * @param startFresh When true, any persisted registration data is not restored and the user starts the flow fresh
      *   from the beginning.
+     * @param isReRegistration When true, this flow was explicitly started to register the existing account again.
      */
     @JvmStatic
     @JvmOverloads
-    fun createIntent(context: Context, nextIntent: Intent? = null, startDestination: RegistrationRoute? = null, startFresh: Boolean = false): Intent {
+    fun createIntent(
+      context: Context,
+      nextIntent: Intent? = null,
+      startDestination: RegistrationRoute? = null,
+      startFresh: Boolean = false,
+      isReRegistration: Boolean = false
+    ): Intent {
       return Intent(context, RegistrationActivity::class.java).apply {
         if (nextIntent != null) {
           putExtra(REGISTRATION_NEXT_INTENT_EXTRA, nextIntent)
@@ -71,6 +79,7 @@ class RegistrationActivity : PassphraseRequiredActivity() {
           putExtra(START_DESTINATION_EXTRA, startDestination)
         }
         putExtra(START_FRESH_EXTRA, startFresh)
+        putExtra(IS_REREGISTRATION_EXTRA, isReRegistration)
       }
     }
   }
@@ -81,6 +90,7 @@ class RegistrationActivity : PassphraseRequiredActivity() {
 
     val startDestination = IntentCompat.getParcelableExtra(intent, START_DESTINATION_EXTRA, RegistrationRoute::class.java)
     val startFresh = intent.getBooleanExtra(START_FRESH_EXTRA, false)
+    val isReRegistration = intent.getBooleanExtra(IS_REREGISTRATION_EXTRA, false)
 
     setContent {
       SignalTheme(incognitoKeyboardEnabled = SignalStore.settings.isIncognitoKeyboardEnabled) {
@@ -92,6 +102,9 @@ class RegistrationActivity : PassphraseRequiredActivity() {
               .fillMaxSize()
               .navigationBarsPadding(),
             onRegistrationComplete = {
+              if (SignalStore.account.isPrimaryDevice && SignalStore.account.isMultiDevice) {
+                SignalStore.misc.shouldShowLinkedDevicesReminder = isReRegistration
+              }
               setResult(RESULT_OK)
               IntentCompat.getParcelableExtra(intent, REGISTRATION_NEXT_INTENT_EXTRA, Intent::class.java)?.let { startActivity(it) }
               finish()
diff --git a/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntents.kt b/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntents.kt
index 0344db79..709ff882 100644
--- a/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntents.kt
+++ b/app/src/main/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntents.kt
@@ -22,7 +22,12 @@ object RegistrationIntents {
 
   @JvmStatic
   fun newIntentForReRegistration(context: Context): Intent {
-    return RegistrationActivity.createIntent(context, nextIntent = MainActivity.clearTop(context), startFresh = true)
+    return RegistrationActivity.createIntent(
+      context = context,
+      nextIntent = MainActivity.clearTop(context),
+      startFresh = true,
+      isReRegistration = true
+    )
   }
 
   @JvmStatic
diff --git a/app/src/test/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntentsTest.kt b/app/src/test/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntentsTest.kt
new file mode 100644
index 00000000..1d8f01a8
--- /dev/null
+++ b/app/src/test/java/org/thoughtcrime/securesms/registration/ui/RegistrationIntentsTest.kt
@@ -0,0 +1,32 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.registration.ui
+
+import android.app.Application
+import androidx.test.core.app.ApplicationProvider
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, application = Application::class)
+class RegistrationIntentsTest {
+
+  @Test
+  fun `re-registration marker is explicit and absent for fresh registration`() {
+    val context = ApplicationProvider.getApplicationContext<Application>()
+
+    val reRegistration = RegistrationIntents.newIntentForReRegistration(context)
+    val newRegistration = RegistrationIntents.newIntentForNewRegistration(context)
+    val reLink = RegistrationIntents.newIntentForReLinkDevice(context)
+
+    assertTrue(reRegistration.getBooleanExtra(RegistrationActivity.IS_REREGISTRATION_EXTRA, false))
+    assertFalse(newRegistration.getBooleanExtra(RegistrationActivity.IS_REREGISTRATION_EXTRA, false))
+    assertFalse(reLink.getBooleanExtra(RegistrationActivity.IS_REREGISTRATION_EXTRA, false))
+  }
+}
