     <color name="settings_ripple_color">@color/transparent_white_10</color>
 
-    <color name="quote_view_background_outgoing_wallpaper">@color/transparent_black_40</color>
-    <color name="quote_view_bar_outgoing_wallpaper">@color/signal_colorOnCustom</color>
-    <color name="quote_view_foreground_outgoing_wallpaper">@color/signal_colorNeutralInverse</color>
-    <color name="quote_view_background_outgoing_normal">@color/transparent_black_40</color>
-    <color name="quote_view_foreground_outgoing_normal">@color/signal_colorNeutralInverse</color>
+    <!-- <color name="quote_view_background_outgoing_wallpaper">@color/transparent_black_40</color> -->
+    <!-- <color name="quote_view_bar_outgoing_wallpaper">@color/signal_colorOnCustom</color> -->
