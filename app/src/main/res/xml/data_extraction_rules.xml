<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the CollieSocket enrollment export (it holds the linked-device password) out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
        <exclude domain="device_sharedpref" path="collie_appearance.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
        <exclude domain="device_sharedpref" path="collie_appearance.xml" />
    </device-transfer>
</data-extraction-rules>
