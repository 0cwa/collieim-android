<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.CoreUi.FixedRoundedCorners" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/Widget.CoreUi.FixedRoundedCorners.BottomSheet</item>
        <item name="android:windowEnterAnimation">@anim/slide_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_to_bottom</item>
        <!-- Only applies under API 35, otherwise edge-to-edge enforcement keeps the bar transparent and the sheet draws behind it. -->
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/signal_bottom_sheet_navigation_bar</item>
    </style>

    <style name="Widget.CoreUi.FixedRoundedCorners.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Signal.BottomSheet.Rounded</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="android:elevation" tools:ignore="NewApi">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Signal.BottomSheet.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">@dimen/bottom_sheet_corner_size</item>
        <item name="cornerSizeTopLeft">@dimen/bottom_sheet_corner_size</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!--
      Collie: Pure black, applied after the color palette to effectively dark activities that follow the app's mode.
      Only the base surface roles change; elevated containers, accents and foregrounds keep the palette's values, and
      window, bar and translucency policy stays with each Activity's style. SignalTheme applies the same roles.
    -->
    <style name="ThemeOverlay.Collie.PureBlack" parent="">
        <item name="collie_pure_black">true</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceDim">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
    </style>

</resources>
