diff --git a/rtc_base/socket_adapters.cc b/rtc_base/socket_adapters.cc
--- a/rtc_base/socket_adapters.cc
+++ b/rtc_base/socket_adapters.cc
@@ -8,9 +8,18 @@
     request.WriteUInt8(3);  // DOMAINNAME
     request.WriteUInt8(static_cast<uint8_t>(hostname.size()));
     request.WriteString(hostname);  // Destination Hostname
-  } else {
+  } else if (dest_.family() == AF_INET) {
     request.WriteUInt8(1);            // IPV4
     request.WriteUInt32(dest_.ip());  // Destination IP
+  } else if (dest_.family() == AF_INET6) {
+    request.WriteUInt8(4);  // IPV6
+    const auto address = dest_.ipaddr().ipv6_address();
+    for (uint8_t byte : address.s6_addr) {
+      request.WriteUInt8(byte);
+    }
+  } else {
+    Error(SOCKET_EACCES);
+    return;
   }
   request.WriteUInt16(dest_.port());  // Destination Port
   DirectSend(request.Data(), request.Length());
