+    <!-- <color name="quote_view_foreground_outgoing_normal">@color/signal_colorNeutralInverse</color> -->
     <color name="top_toast_background_color">@color/core_grey_80</color>
 
     <color name="sent_gift_button_tint">@color/transparent_white_20</color>
