-  private val _actions = Channel<DeviceTransferTestAction>(Channel.BUFFERED)
-
-  val state: StateFlow<DeviceTransferTestState> = _state.asStateFlow()
-  val actions: Flow<DeviceTransferTestAction> = _actions.receiveAsFlow()
-
-  init {
