      "source_bundle_bytes": 5177
    },
    {
      "id": "followups/backup-revision-walk",
      "source_commit": "538be6ced48eae839052e17e30a24bae380c54f9",
      "description": "Apply Molly's backup timer rule to the latest message revision\n\nAI-assisted compatibility changes. The port excluded a message from backups\nwhen any earlier revision had a started disappearing timer, and dropped\nmessages whose revision chain contained a cycle. Walk revisions as Signal\ndoes, stopping at a cycle, and apply Molly's started-timer exclusion to the\nrevision the walk ends on.\n\nAI-Generated: true\n\nBased-On-Source-Commit: 53bb4511abbfd5339db82305f1da8cb1f0655516",
      "ai_generated": true,
      "before_tree": "db57911a1d1a93efbed65eab782de764ce6ec272",
