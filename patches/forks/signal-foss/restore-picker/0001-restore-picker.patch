Subject: [PATCH] Find timestamped backups regardless of filename prefix

AI-assisted Collie restore picker fix. Scan only the user-selected folder; do not migrate or delete files.
Source-Commit: e4a00a4cd9a45cf5406e85a022565dadaf1ebf65

---
 .../v2/AppRegistrationStorageController.kt    |  4 +-
 .../v2/LocalBackupFolderScanTest.kt           | 72 +++++++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)
 create mode 100644 app/src/test/java/org/thoughtcrime/securesms/registration/v2/LocalBackupFolderScanTest.kt

diff --git a/app/src/main/java/org/thoughtcrime/securesms/registration/v2/AppRegistrationStorageController.kt b/app/src/main/java/org/thoughtcrime/securesms/registration/v2/AppRegistrationStorageController.kt
index 536a2a0dcb..a05e911205 100644
--- a/app/src/main/java/org/thoughtcrime/securesms/registration/v2/AppRegistrationStorageController.kt
+++ b/app/src/main/java/org/thoughtcrime/securesms/registration/v2/AppRegistrationStorageController.kt
@@ -133,7 +133,7 @@ class AppRegistrationStorageController(private val context: Context) : StorageCo
     private val TAG = Log.tag(AppRegistrationStorageController::class)
     private const val TEMP_PROTO_FILENAME = "registration-in-progress.proto"
     private val MODERN_BACKUP_PATTERN = Regex("^signal-backup-(\\d{4})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})$")
-    private val LEGACY_BACKUP_PATTERN = Regex("^signal-(\\d{4})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})\\.backup$")
+    private val LEGACY_BACKUP_PATTERN = Regex("^.+-(\\d{4})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})-(\\d{2})\\.backup$")
   }
 
   override fun onRegistrationPermissionsResult() {
@@ -556,7 +556,7 @@ class AppRegistrationStorageController(private val context: Context) : StorageCo
       }
     }
 
-    // Check for legacy backups: signal-yyyy-MM-dd-HH-mm-ss.backup files
+    // Check for timestamped legacy backups, regardless of the app-specific filename prefix.
     for (child in effectiveChildren) {
       if (!child.isFile) continue
       val name = child.name ?: continue
diff --git a/app/src/test/java/org/thoughtcrime/securesms/registration/v2/LocalBackupFolderScanTest.kt b/app/src/test/java/org/thoughtcrime/securesms/registration/v2/LocalBackupFolderScanTest.kt
new file mode 100644
index 0000000000..fc5c660a8f
--- /dev/null
+++ b/app/src/test/java/org/thoughtcrime/securesms/registration/v2/LocalBackupFolderScanTest.kt
@@ -0,0 +1,72 @@
+package org.thoughtcrime.securesms.registration.v2
+
+import android.app.Application
+import android.net.Uri
+import androidx.documentfile.provider.DocumentFile
+import androidx.test.core.app.ApplicationProvider
+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkStatic
+import io.mockk.unmockkAll
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.BeforeClass
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.signal.core.util.logging.Log
+import org.thoughtcrime.securesms.testutil.EmptyLogger
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, manifest = Config.NONE)
+class LocalBackupFolderScanTest {
+  companion object {
+    @BeforeClass
+    @JvmStatic
+    fun initLogger() = Log.initialize(EmptyLogger())
+  }
+
+  @After
+  fun tearDown() = unmockkAll()
+
+  @Test
+  fun `selected folder lists timestamped backup candidates regardless of prefix in date order`() = runBlocking {
+    val context = ApplicationProvider.getApplicationContext<Application>()
+    val rootUri = Uri.parse("content://test/backups")
+    val folder = mockk<DocumentFile>()
+    val names = listOf(
+      "signal-2026-01-01-12-00-00.backup",
+      "collie-2026-02-01-12-00-00.backup",
+      "molly-foss-continued-2026-03-01-12-00-00.backup",
+      "other-app-2026-04-01-12-00-00.backup",
+      "collie-2026-02-30-12-00-00.backup",
+      "collie-2026-01-01-12-00-00.txt",
+      "unrelated.backup",
+      "-2026-01-01-12-00-00.backup"
+    )
+    val files = names.map { name ->
+      val file = mockk<DocumentFile>()
+      every { file.isDirectory } returns false
+      every { file.isFile } returns true
+      every { file.name } returns name
+      every { file.uri } returns Uri.parse("content://test/backups/$name")
+      every { file.length() } returns 123L
+      file
+    }.toTypedArray()
+    mockkStatic(DocumentFile::class)
+    every { DocumentFile.fromTreeUri(context, rootUri) } returns folder
+    every { folder.listFiles() } returns files
+
+    assertThat(AppRegistrationStorageController(context).scanLocalBackupFolder(rootUri).map { it.name }).isEqualTo(
+      listOf(
+        "other-app-2026-04-01-12-00-00.backup",
+        "molly-foss-continued-2026-03-01-12-00-00.backup",
+        "collie-2026-02-01-12-00-00.backup",
+        "signal-2026-01-01-12-00-00.backup"
+      )
+    )
+  }
+}
