diff --git a/rust/net/src/connect_state.rs b/rust/net/src/connect_state.rs
index 7d242b7b..64381126 100644
--- a/rust/net/src/connect_state.rs
+++ b/rust/net/src/connect_state.rs
@@ -940,6 +940,18 @@ mod test {
     use crate::ws::NotRejectedByServer;
 
     const FAKE_HOST_NAME: &str = "direct-host";
+
+    #[test_case("org.signal.tls"; "signal_tls")]
+    #[test_case("http"; "http")]
+    #[test_case("https"; "https")]
+    #[test_case("socks5h"; "socks5h")]
+    fn configured_proxy_never_falls_back_to_direct(scheme: &str) {
+        let config = ConnectionProxyConfig::from_parts(scheme, "proxy.example", None, None)
+            .expect("valid proxy configuration");
+
+        assert_matches!(infer_proxy_mode_for_config(config), DirectOrProxyMode::ProxyOnly(_));
+    }
+
