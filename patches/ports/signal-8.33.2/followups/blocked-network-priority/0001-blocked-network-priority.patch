Subject: [PATCH] Derived compatibility checkpoint:
 followups/blocked-network-priority

Preserve Molly blocked-network priority, including a blocked VPN with an unvalidated underlying network.

Original-Source-Commit: 7a2ec75db0b56f45310d09716a3559e5dd503b19
AI-Generated: true

Source-Commit: 043a03f3b8f85db985b1ca6522d0696110de8366

diff --git a/app/src/main/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculator.kt b/app/src/main/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculator.kt
index 3e5041da..25e8f148 100644
--- a/app/src/main/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculator.kt
+++ b/app/src/main/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculator.kt
@@ -47,8 +47,8 @@ data class NetworkState(
     get() = when {
       isReachable && onVpn -> 4
       isReachable -> 3
-      !blocked -> 2
-      blocked && onVpn -> 1
+      blocked && onVpn -> 2
+      blocked -> 1
       else -> 0
     }
 }
diff --git a/app/src/test/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculatorTest.kt b/app/src/test/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculatorTest.kt
index 14a023e7..76eff6b7 100644
--- a/app/src/test/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculatorTest.kt
+++ b/app/src/test/java/org/thoughtcrime/securesms/net/ConnectivityStateCalculatorTest.kt
@@ -98,11 +98,20 @@ class ConnectivityStateCalculatorTest {
   }
 
   @Test
-  fun `a usable unvalidated network outranks a blocked one`() {
+  fun `a blocked network outranks an unvalidated network`() {
     val states = listOf(
       NetworkState(validated = true, blocked = true, onVpn = false),
       NetworkState(validated = false, blocked = false, onVpn = false)
     )
-    assertThat(ConnectivityStateCalculator.calculate(states)).isEqualTo(ConnectivityState.CONNECTED_UNVALIDATED)
+    assertThat(ConnectivityStateCalculator.calculate(states)).isEqualTo(ConnectivityState.BLOCKED)
+  }
+
+  @Test
+  fun `a blocked vpn outranks an unvalidated underlying network`() {
+    val states = listOf(
+      NetworkState(validated = true, blocked = true, onVpn = true),
+      NetworkState(validated = false, blocked = false, onVpn = false)
+    )
+    assertThat(ConnectivityStateCalculator.calculate(states)).isEqualTo(ConnectivityState.BLOCKED_VPN)
   }
 }
