From d6a8c624baf607229468820896e3e994c6827afe Mon Sep 17 00:00:00 2001
From: Collie Contributors <contributors@collie.invalid>
Date: Fri, 6 Nov 2026 14:11:30 +0100
Subject: [PATCH] Use mandatory Collie native coordinates

AI-assisted compatibility change. Requires the staged, reviewed native artifacts.
Source-Commit: d6a8c624baf607229468820896e3e994c6827afe

---
 gradle/libs.versions.toml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/gradle/libs.versions.toml b/gradle/libs.versions.toml
index 11db6c19be..8f4e972a5a 100644
--- a/gradle/libs.versions.toml
+++ b/gradle/libs.versions.toml
@@ -28,7 +28,7 @@ androidx-navigation3-core = "1.1.4"
 androidx-core-telecom = "1.1.0-alpha06"
 androidx-window = "1.3.0"
 glide = "5.0.9"
-libsignal-client = "0.105.4-1"
+libsignal-client = "0.106.1-collie.1"
 mp4parser = "1.9.39"
 accompanist = "0.28.0"
 nanohttpd = "2.3.1"
@@ -165,11 +165,11 @@ jsilver = "com.google.jsilver:jsilver:1.0.0"
 firebase-messaging = "com.google.firebase:firebase-messaging:25.0.1"
 
 # 1st Party
-libsignal-client = { module = "im.molly:libsignal-client", version.ref = "libsignal-client" }
-libsignal-android = { module = "im.molly:libsignal-android", version.ref = "libsignal-client" }
+libsignal-client = { module = "im.collie.native:libsignal-client", version.ref = "libsignal-client" }
+libsignal-android = { module = "im.collie.native:libsignal-android", version.ref = "libsignal-client" }
 protobuf-gradle-plugin = { module = "com.google.protobuf:protobuf-gradle-plugin", version.ref = "protobuf-gradle-plugin" }
 signal-aesgcmprovider = "org.signal:aesgcmprovider:0.0.4"
-signal-ringrtc = "im.molly:ringrtc-android:2.73.0-1"
+signal-ringrtc = "im.collie.native:ringrtc-android:2.74.0-collie.1"
 
 # MOLLY
 gosimple-nbvcxz = "me.gosimple:nbvcxz:1.5.0"
